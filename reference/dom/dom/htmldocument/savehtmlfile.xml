<refentry xml:id="dom-htmldocument.savehtmlfile" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Dom\HTMLDocument::saveHtmlFile</refname>
  <refpurpose>Sérialise le document sous forme de fichier <acronym>HTML</acronym></refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Dom\\HTMLDocument">
   <modifier>public</modifier> <type class="union"><type>int</type><type>false</type></type><methodname>Dom\HTMLDocument::saveHtmlFile</methodname>
   <methodparam><type>string</type><parameter>filename</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Sérialise le document sous forme de fichier <acronym>HTML</acronym>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>filename</parameter></term>
    <listitem>
     <simpara>
      Le chemin du fichier sur lequel sauvegarder le document.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Le nombre d'octets écrits en cas de succès, ou &false; en cas d'échec.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     Lève une <exceptionname>ValueError</exceptionname> si
     <parameter>filename</parameter> est une chaîne vide ou contient des
     octets nuls.
    </simpara>
   </listitem>
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="dom-htmldocument.savehtmlfile.example.basic">
   <title>Exemple de <methodname>Dom\HTMLDocument::saveHtmlFile</methodname></title>
   <simpara>
    Sérialise un document sous forme de fichier <acronym>HTML</acronym>.
   </simpara>
   <programlisting role="php">
<![CDATA[
<?php
$dom = Dom\HTMLDocument::createFromString('<!DOCTYPE html><p>Hello, world!</p>');
$bytes = $dom->saveHtmlFile('/path/to/output.html');
echo "$bytes octets enregistrés\n";
var_dump($bytes);
?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
74 octets enregistrés
int(74)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Dom\HTMLDocument::saveHtml</methodname></member>
   <member><methodname>Dom\HTMLDocument::saveXmlFile</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
