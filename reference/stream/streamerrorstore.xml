<reference xml:id="enum.streamerrorstore" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>L'énumération StreamErrorStore</title>
 <titleabbrev>StreamErrorStore</titleabbrev>

 <partintro>
  <section xml:id="enum.streamerrorstore.intro">
   &reftitle.intro;
   <simpara>
    L'énumération <enumname>StreamErrorStore</enumname> spécifie quelles erreurs d'une
    opération sur un flux sont conservées pour être récupérées avec
    <function>stream_last_errors</function>. C'est la valeur de l'option
    de contexte de flux
    <link linkend="context.stream.error-store"><parameter>error_store</parameter></link>.
   </simpara>
  </section>

  <section xml:id="enum.streamerrorstore.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>StreamErrorStore</enumname>

    <enumitem>
     <enumidentifier>Auto</enumidentifier>
     <enumitemdescription>
      Les erreurs conservées dépendent du mode d'erreur.
      C'est la valeur par défaut.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>None</enumidentifier>
     <enumitemdescription>
      Aucune erreur n'est conservée.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>NonTerminating</enumidentifier>
     <enumitemdescription>
      Seules les erreurs non fatales à l'opération sont conservées.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Terminating</enumidentifier>
     <enumitemdescription>
      Seules les erreurs fatales à l'opération sont conservées.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>All</enumidentifier>
     <enumitemdescription>
      Toutes les erreurs sont conservées.
     </enumitemdescription>
    </enumitem>
   </enumsynopsis>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><enumname>StreamErrorMode</enumname></member>
    <member><function>stream_last_errors</function></member>
    <member><xref linkend="context.stream"/></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>
 </partintro>
</reference>
