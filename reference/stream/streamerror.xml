<reference xml:id="class.streamerror" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">

 <title>La classe StreamError</title>
 <titleabbrev>StreamError</titleabbrev>

 <partintro>

  <section xml:id="streamerror.intro">
   &reftitle.intro;
   <simpara>
    Un objet <exceptionname>StreamError</exceptionname> décrit une erreur unique
    signalée par une opération sur un flux. Les instances sont créées par PHP et
    sont retournées par <function>stream_last_errors</function> et
    <methodname>StreamException::getErrors</methodname>, et passées à l'option
    de contexte de flux
    <link linkend="context.stream.error-handler"><parameter>error_handler</parameter></link>.
   </simpara>
  </section>

  <section xml:id="streamerror.synopsis">
   &reftitle.classsynopsis;

   <classsynopsis class="class">
    <ooclass>
     <modifier>final</modifier>
     <modifier>readonly</modifier>
     <classname>StreamError</classname>
    </ooclass>

    <classsynopsisinfo role="comment">&Properties;</classsynopsisinfo>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>StreamErrorCode</type>
     <varname linkend="streamerror.props.code">code</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>string</type>
     <varname linkend="streamerror.props.message">message</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>string</type>
     <varname linkend="streamerror.props.wrappername">wrapperName</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>int</type>
     <varname linkend="streamerror.props.severity">severity</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>bool</type>
     <varname linkend="streamerror.props.terminating">terminating</varname>
    </fieldsynopsis>
   </classsynopsis>
  </section>

  <section xml:id="streamerror.props">
   &reftitle.properties;
   <variablelist>
    <varlistentry xml:id="streamerror.props.code">
     <term><varname>code</varname></term>
     <listitem>
      <simpara>
       Le cas de <enumname>StreamErrorCode</enumname> identifiant le type d'erreur.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.message">
     <term><varname>message</varname></term>
     <listitem>
      <simpara>
       Le message d'erreur. Il s'agit du texte du diagnostic émis
       avec <constant>StreamErrorMode::Error</constant>, sans le préfixe
       du nom de la fonction.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.wrappername">
     <term><varname>wrapperName</varname></term>
     <listitem>
      <simpara>
       Le nom de l'enveloppe de flux qui a signalé l'erreur,
       par exemple <literal>plainfile</literal> pour les fichiers locaux.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.severity">
     <term><varname>severity</varname></term>
     <listitem>
      <simpara>
       Le niveau avec lequel l'erreur est signalée dans le mode
       <constant>StreamErrorMode::Error</constant>,
       sous la forme d'une des constantes <link linkend="errorfunc.constants.errorlevels"><constant>E_<replaceable>*</replaceable></constant></link>,
       comme <constant>E_WARNING</constant> ou <constant>E_NOTICE</constant>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.terminating">
     <term><varname>terminating</varname></term>
     <listitem>
      <simpara>
       &true; si l'erreur a mis fin à l'opération et lance une
       <exceptionname>StreamException</exceptionname> dans le mode
       <constant>StreamErrorMode::Exception</constant>, &false; sinon.
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><function>stream_last_errors</function></member>
    <member><methodname>StreamException::getErrors</methodname></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>

 </partintro>

</reference>
