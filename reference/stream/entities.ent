<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.stream.context-error-handling">
 <simpara>
  Un contexte <type>resource</type> créé avec
  <function>stream_context_create</function>, ou &null;.
  Ses <link linkend="context.stream">options de gestion des erreurs</link>
  déterminent comment les erreurs de flux de cet appel sont signalées.
 </simpara>
</entity>

</entities>
