<refentry xml:id="time-duration.unserialize" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::__unserialize</refname>
  <refpurpose>Restaure une durée à partir de données sérialisées</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>void</type><methodname>Time\Duration::__unserialize</methodname>
   <methodparam><type>array</type><parameter>data</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Désérialise le &array; du paramètre <parameter>data</parameter>
   en un objet <classname>Time\Duration</classname>.
   Cette méthode est appelée par <function>unserialize</function> et n'est pas
   destinée à être appelée directement.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>data</parameter></term>
    <listitem>
     <simpara>
      Les données sérialisées sous forme de <type>array</type>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Si <parameter>data</parameter> ne décrit pas une durée valide, une
   <exceptionname>Exception</exceptionname> est lancée.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>serialize</function></member>
   <member><function>unserialize</function></member>
   <member><link linkend="language.oop5.magic">Méthodes magiques</link></member>
  </simplelist>
 </refsect1>

</refentry>
