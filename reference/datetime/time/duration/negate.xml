<refentry xml:id="time-duration.negate" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::negate</refname>
  <refpurpose>Retourne la durée avec le signe opposé</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>Time\Duration</type><methodname>Time\Duration::negate</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Retourne une durée de même longueur avec le signe opposé : une durée
   positive devient négative, et une durée négative devient positive.
   Inverser le signe d'une durée nulle retourne une durée nulle, qui n'est
   jamais négative.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retourne un nouvel objet <classname>Time\Duration</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.negate.example.basic">
   <title>Exemple avec <methodname>Time\Duration::negate</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$duration = \Time\Duration::fromSeconds(30);

var_dump($duration->negate()->negative);
var_dump($duration->negate()->negate()->negative);

// Une durée nulle n'a pas de signe.
var_dump(\Time\Duration::fromSeconds(0)->negate()->negative);
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
bool(true)
bool(false)
bool(false)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::absolute</methodname></member>
   <member><methodname>Time\Duration::sub</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
