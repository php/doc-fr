<refentry xml:id="time-duration.construct" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::__construct</refname>
  <refpurpose>Constructeur privé pour interdire l'instanciation directe</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <constructorsynopsis role="Time\\Duration">
   <modifier>private</modifier> <methodname>Time\Duration::__construct</methodname>
   <void/>
  </constructorsynopsis>
  <simpara>
   Ce constructeur privé empêche de créer des objets
   <classname>Time\Duration</classname> avec <literal>new</literal>.
   Il faut utiliser à la place l'une des méthodes de fabrique, qui rendent
   explicite l'unité de la valeur donnée :
   <methodname>Time\Duration::fromSeconds</methodname>,
   <methodname>Time\Duration::fromNanoseconds</methodname>,
   <methodname>Time\Duration::fromMicroseconds</methodname>,
   <methodname>Time\Duration::fromMilliseconds</methodname>,
   <methodname>Time\Duration::fromMinutes</methodname>,
   <methodname>Time\Duration::fromHours</methodname>, ou
   <methodname>Time\Duration::fromIso8601DurationString</methodname>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Tenter d'instancier la classe avec <literal>new</literal> lance une
   <exceptionname>Error</exceptionname>.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::fromSeconds</methodname></member>
   <member><methodname>Time\Duration::fromIso8601DurationString</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
