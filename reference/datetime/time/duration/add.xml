<refentry xml:id="time-duration.add" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::add</refname>
  <refpurpose>Ajoute une durée</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>Time\Duration</type><methodname>Time\Duration::add</methodname>
   <methodparam><type>Time\Duration</type><parameter>duration</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Retourne la somme de cette durée et de <parameter>duration</parameter>.
   Le signe des deux durées est pris en compte : ajouter une durée négative
   raccourcit donc une durée positive.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>duration</parameter></term>
    <listitem>
     <simpara>
      La durée à ajouter.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retourne un nouvel objet <classname>Time\Duration</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   &ext.datetime.duration-too-long;
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.add.example.basic">
   <title>Exemple avec <methodname>Time\Duration::add</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$total = \Time\Duration::fromMinutes(1)
    ->add(\Time\Duration::fromSeconds(30))
    ->add(\Time\Duration::fromMilliseconds(500));

var_dump($total);

// Ajouter une durée négative revient à la soustraire.
$result = \Time\Duration::fromSeconds(10)
    ->add(\Time\Duration::fromSeconds(4)->negate());

var_dump($result->seconds);
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
object(Time\Duration)#2 (3) {
  ["seconds"]=>
  int(90)
  ["nanoseconds"]=>
  int(500000000)
  ["negative"]=>
  bool(false)
}
int(6)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::sub</methodname></member>
   <member><methodname>Time\Duration::multiplyBy</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
