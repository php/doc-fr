<!-- EN-Revision: e3a18f9f54b62dfa2bec447adb339ff46754e495 Maintainer: lacatoire Status: ready -->
<!--
    See `manual.xml` for XML namespaces defaults.
    Keep the lines under 79 columns, to make the process of manual
    translation easier, and to avoid wrap-around in some other contexts.
-->
<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.snmp.changelog.object-id-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Lance désormais une <exceptionname>ValueError</exceptionname> si
   <parameter>object_id</parameter> est un <type>array</type> vide.
   Auparavant, une <constant>E_WARNING</constant> était émise et &false;
   était retourné.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.security-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Lance désormais une <exceptionname>ValueError</exceptionname> si
   <parameter>security_level</parameter> n'est pas un niveau de sécurité
   valide, ou si <parameter>auth_protocol</parameter> ou
   <parameter>privacy_protocol</parameter> n'est pas un protocole supporté et
   que <parameter>security_level</parameter> l'utilise.
   Auparavant, une <constant>E_WARNING</constant> était émise et &false;
   était retourné.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Lance désormais une <exceptionname>ValueError</exceptionname> quand
   <parameter>hostname</parameter> ou <parameter>community</parameter>
   contient des octets nuls, quand la longueur du nom d'hôte est supérieure
   ou égale à 128 octets, quand <parameter>community</parameter> est vide,
   quand le port est négatif ou supérieur à 65535, ou quand les valeurs du
   délai d'expiration ou du nombre de tentatives sont inférieures à -1 ou
   trop grandes.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror.v3">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Lance désormais une <exceptionname>ValueError</exceptionname> quand
   <parameter>hostname</parameter> ou <parameter>security_name</parameter>
   contient des octets nuls, quand la longueur du nom d'hôte est supérieure
   ou égale à 128 octets, quand <parameter>security_name</parameter> est
   vide, quand le port est négatif ou supérieur à 65535, ou quand les valeurs
   du délai d'expiration ou du nombre de tentatives sont inférieures à -1 ou
   trop grandes.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.set-type-errors">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Lance désormais une <exceptionname>TypeError</exceptionname> si
   <parameter>object_id</parameter> est une <type>string</type> et que
   <parameter>type</parameter> ou <parameter>value</parameter> est un
   <type>array</type>, et une <exceptionname>ValueError</exceptionname> si un
   type n'est pas un caractère unique.
   Auparavant, une <constant>E_WARNING</constant> était émise et &false;
   était retourné.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.object-id-valueerror">
 <simpara>
  Lève une <exceptionname>ValueError</exceptionname> si
  <parameter>object_id</parameter> est un <type>array</type> vide.
 </simpara>
</entity>

<entity name="ext.snmp.security-valueerror">
 <simpara>
  Lève une <exceptionname>ValueError</exceptionname> si
  <parameter>security_level</parameter> n'est pas un niveau de sécurité
  valide, ou si <parameter>auth_protocol</parameter> ou
  <parameter>privacy_protocol</parameter> n'est pas un protocole supporté et
  que <parameter>security_level</parameter> l'utilise.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror">
 <simpara>
  À partir de PHP 8.5.0, lève une <exceptionname>ValueError</exceptionname> si
  <parameter>hostname</parameter> ou <parameter>community</parameter>
  contient des octets nuls, si <parameter>hostname</parameter> fait 128 octets
  ou plus ou contient un port qui n'est pas compris entre 0 et 65535, si
  <parameter>community</parameter> est vide, ou si
  <parameter>timeout</parameter> ou <parameter>retries</parameter> est
  inférieur à <literal>-1</literal> ou trop grand.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror.v3">
 <simpara>
  À partir de PHP 8.5.0, lève une <exceptionname>ValueError</exceptionname> si
  <parameter>hostname</parameter> ou <parameter>security_name</parameter>
  contient des octets nuls, si <parameter>hostname</parameter> fait 128 octets
  ou plus ou contient un port qui n'est pas compris entre 0 et 65535, si
  <parameter>security_name</parameter> est vide, ou si
  <parameter>timeout</parameter> ou <parameter>retries</parameter> est
  inférieur à <literal>-1</literal> ou trop grand.
 </simpara>
</entity>

<entity name="ext.snmp.set-type-errors">
 <simpara>
  Lève une <exceptionname>TypeError</exceptionname> si
  <parameter>object_id</parameter> est une <type>string</type> et que
  <parameter>type</parameter> ou <parameter>value</parameter> est un
  <type>array</type>.
  Lève une <exceptionname>ValueError</exceptionname> si
  <parameter>object_id</parameter> est une <type>string</type> et que
  <parameter>type</parameter> n'est pas un caractère unique, ou si
  <parameter>type</parameter> est un <type>array</type> et que le type d'un
  identifiant d'objet n'est pas un caractère unique.
 </simpara>
</entity>

</entities>
