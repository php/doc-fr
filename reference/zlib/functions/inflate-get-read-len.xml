<refentry xml:id="function.inflate-get-read-len" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>inflate_get_read_len</refname>
  <refpurpose>Renvoie le nombre d'octets lus jusqu'à présent</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>int</type><methodname>inflate_get_read_len</methodname>
   <methodparam><type>InflateContext</type><parameter>context</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Retourne le nombre d'octets compressés lus jusqu'à présent depuis le flux
   courant. Le compteur est remis à <literal>0</literal> au premier appel de
   <function>inflate_add</function> après la fin du flux précédent.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>context</parameter></term>
    <listitem>
     <simpara>
      Un contexte créé avec <function>inflate_init</function>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Renvoie le nombre d'octets lus jusqu'à présent depuis le flux courant.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       <parameter>context</parameter> attend désormais une instance de <classname>InflateContext</classname> ;
       auparavant, une <type>resource</type> était attendue.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

</refentry>
