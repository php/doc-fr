<refentry xml:id='function.cal-to-jd' xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>cal_to_jd</refname>
  <refpurpose>Convertit un calendrier en nombre de jours Julien</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>int</type><methodname>cal_to_jd</methodname>
   <methodparam><type>int</type><parameter>calendar</parameter></methodparam>
   <methodparam><type>int</type><parameter>month</parameter></methodparam>
   <methodparam><type>int</type><parameter>day</parameter></methodparam>
   <methodparam><type>int</type><parameter>year</parameter></methodparam>
  </methodsynopsis>
  <para>
   <function>cal_to_jd</function> calcule le nombre de jours Julien
   pour une date, dans le calendrier <parameter>calendar</parameter>.
   Les valeurs possibles pour <parameter>calendar</parameter> sont
   <constant>CAL_GREGORIAN</constant>,
   <constant>CAL_JULIAN</constant>,
   <constant>CAL_JEWISH</constant> et
   <constant>CAL_FRENCH</constant>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>calendar</parameter></term>
     <listitem>
      <para>
       Calendrier à convertir. Un parmi
       <constant>CAL_GREGORIAN</constant>,
       <constant>CAL_JULIAN</constant>,
       <constant>CAL_JEWISH</constant> ou
       <constant>CAL_FRENCH</constant>.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>month</parameter></term>
     <listitem>
      <para>
       Le mois, sous la forme d'un nombre. L'intervalle valide
       dépend du calendrier <parameter>calendar</parameter>
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>day</parameter></term>
     <listitem>
      <para>
       Le jour, sous la forme d'un nombre. L'intervalle valide
       dépend du calendrier <parameter>calendar</parameter>
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>year</parameter></term>
     <listitem>
      <para>
       L'année, sous la forme d'un nombre. L'intervalle valide
       dépend du calendrier <parameter>calendar</parameter>
      </para>
     </listitem>
    </varlistentry>  
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Le nombre de jours Julien.
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lève une <exceptionname>ValueError</exceptionname> si <parameter>calendar</parameter>
   n'est pas un identifiant de calendrier valide, si <parameter>month</parameter> est inférieur à <literal>1</literal>,
   ou si <parameter>month</parameter>, <parameter>day</parameter> ou <parameter>year</parameter>
   dépasse l'intervalle 32 bits pris en charge. Les autres dates invalides retournent <literal>0</literal>.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Lève désormais une <exceptionname>ValueError</exceptionname> si <parameter>calendar</parameter>
       n'est pas un identifiant de calendrier valide.
       Auparavant, une <constant>E_WARNING</constant> était émise et &false; était retournée.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>cal_from_jd</function></member>
