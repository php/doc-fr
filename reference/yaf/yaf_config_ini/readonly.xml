<refentry xml:id="yaf-config-ini.readonly" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Config_Ini::readonly</refname>
<refpurpose>Vérifie si la configuration est en lecture seule</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>bool</type><methodname>Yaf_Config_Ini::readonly</methodname>
   <void />
  </methodsynopsis>
  <simpara>Vérifie si la configuration est en lecture seule. <classname>Yaf_Config_Ini</classname> est toujours en lecture seule.</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>Retourne toujours &true;.</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemple avec <methodname>Yaf_Config_Ini::readonly</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$config = new Yaf_Config_Ini('/etc/myapp/application.ini', 'common');

// Yaf_Config_Ini est toujours en lecture seule
var_dump($config->readonly());

// Les tentatives d'écriture sont rejetées (et une alerte est émise)
var_dump($config->set('version', '2.0'));
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(true)
bool(false)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Config_Ini::set</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

