<!-- {{{ Yaf_Application properties -->
  <section xml:id="yaf-application.props">
   &reftitle.properties;
   <variablelist>
    <varlistentry xml:id="yaf-application.props.config">
     <term><varname>config</varname></term>
     <listitem>
      <simpara>L'objet de configuration de l'application.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.dispatcher">
     <term><varname>dispatcher</varname></term>
     <listitem>
      <simpara>L'instance de <classname>Yaf_Dispatcher</classname> utilisée
       par cette application.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.app">
     <term><varname>_app</varname></term>
     <listitem>
      <simpara>Référence statique vers l'unique instance d'application en
       cours d'exécution.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.modules">
     <term><varname>_modules</varname></term>
     <listitem>
      <simpara>La liste des noms de modules enregistrés, analysée à partir de
       <link linkend="configuration.yaf.modules">application.modules</link>.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.running">
     <term><varname>_running</varname></term>
     <listitem>
      <simpara>Indique si l'application est en cours d'exécution.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.environ">
     <term><varname>_environ</varname></term>
     <listitem>
      <simpara>Le nom de l'environnement de l'application, valant
       <literal>"product"</literal> par défaut.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.err-no">
     <term><varname>_err_no</varname></term>
     <listitem>
      <simpara>Le code de la dernière erreur, l'une des constantes
       <link linkend="yaf.constants">YAF_ERR_*</link>.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.err-msg">
     <term><varname>_err_msg</varname></term>
     <listitem>
      <simpara>Le message de la dernière erreur.</simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </section>
<!-- }}} -->


 </partintro>

 &reference.yaf.entities.yaf-application;

