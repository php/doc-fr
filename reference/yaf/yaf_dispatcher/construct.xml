<refentry xml:id="yaf-dispatcher.construct" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Dispatcher::__construct</refname>
  <refpurpose>Constructeur de Yaf_Dispatcher</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <constructorsynopsis>
   <modifier>private</modifier> <methodname>Yaf_Dispatcher::__construct</methodname>
   <void />
  </constructorsynopsis>
  <simpara>
   <classname>Yaf_Dispatcher</classname> implémente le patron singleton, aussi
   son constructeur est-il privé. Il faut utiliser
   <methodname>Yaf_Dispatcher::getInstance</methodname> pour récupérer
   l'instance du distributeur, qui est créée par
   <classname>Yaf_Application</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><classname>Yaf_Dispatcher</classname> est un singleton</title>
   <programlisting role="php">
<![CDATA[
<?php
$app = new Yaf_Application(dirname(__FILE__) . "/conf/application.ini");

// Yaf_Dispatcher implémente le patron singleton, aussi son constructeur
// est-il privé. Il faut récupérer l'instance avec
// Yaf_Dispatcher::getInstance() plutôt que d'appeler `new`.
$dispatcher = Yaf_Dispatcher::getInstance();

var_dump($dispatcher instanceof Yaf_Dispatcher);
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(true)
]]>
   </screen>
  </example>
 </refsect1>
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><methodname>Yaf_Dispatcher::getInstance</methodname></member>
    <member><methodname>Yaf_Application::getDispatcher</methodname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

