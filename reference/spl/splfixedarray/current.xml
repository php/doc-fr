<refentry xml:id="splfixedarray.current" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>SplFixedArray::current</refname>
  <refpurpose>Lit l'élément courant du tableau à taille fixe</refpurpose>
 </refnamediv>
 <refsynopsisdiv>
  &warn.feature.removed-8-0-0;
 </refsynopsisdiv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="SplFixedArray">
   <modifier>public</modifier> <type>mixed</type><methodname>SplFixedArray::current</methodname>
   <void/>
  </methodsynopsis>
  <para>
   Lit l'élément courant du tableau à taille fixe.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   La valeur de l'élément courant.
  </para>
 </refsect1>
 
 <refsect1 role="errors">
  &reftitle.errors;
  <para>
   Lance une exception <classname>RuntimeException</classname>
   lorsque le pointeur interne du tableau pointe vers un
   index invalide ou s'il est supérieur à la taille de ce dernier.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       &removed.function;
       Utilisez <methodname>SplFixedArray::getIterator</methodname> à la place.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>
 
</refentry>

