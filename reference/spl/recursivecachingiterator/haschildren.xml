<refentry xml:id="recursivecachingiterator.haschildren" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>RecursiveCachingIterator::hasChildren</refname>
  <refpurpose>Vérifie si l'élément courant de l'itérateur interne a des fils</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="RecursiveCachingIterator">
   <modifier>public</modifier> <type>bool</type><methodname>RecursiveCachingIterator::hasChildren</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Vérifie si l'élément courant a des fils.
   L'itérateur interne est interrogé lorsque l'itérateur se déplace sur
   l'élément ; cette méthode retourne donc le résultat qui a été stocké à ce
   moment-là.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retourne &true; si l'élément courant a des fils, &false; sinon.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>RecursiveCachingIterator::getChildren</methodname></member>
   <member><methodname>RecursiveIterator::hasChildren</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
