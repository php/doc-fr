<refentry xml:id="cachingiterator.offsetunset" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::offsetUnset</refname>
  <refpurpose>Supprime un élément du cache</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>void</type><methodname>CachingIterator::offsetUnset</methodname>
   <methodparam><type>string</type><parameter>key</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Supprime du cache l'élément stocké sous la clé <parameter>key</parameter>.
   Cette méthode est appelée lorsque <function>unset</function> est utilisé sur
   le <classname>CachingIterator</classname> avec la syntaxe de tableau, comme
   <code>unset($iterator['key'])</code>.
   L'itérateur interne n'est pas modifié.
  </simpara>
  <simpara>
   Le drapeau <constant>CachingIterator::FULL_CACHE</constant> doit être défini.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      La clé de l'élément à supprimer.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lance une <exceptionname>BadMethodCallException</exceptionname> si le
   drapeau <constant>CachingIterator::FULL_CACHE</constant> n'est pas défini.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::offsetExists</methodname></member>
   <member><methodname>CachingIterator::offsetSet</methodname></member>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
