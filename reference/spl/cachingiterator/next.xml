<refentry xml:id="cachingiterator.next" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::next</refname>
  <refpurpose>Avance l'itérateur</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>void</type><methodname>CachingIterator::next</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Avance l'itérateur.
  </simpara>
  <simpara>
   Si l'itérateur interne est valide, sa clé et son élément courants
   deviennent la clé et l'élément courants du
   <classname>CachingIterator</classname>, et sont ajoutés au cache si
   <constant>CachingIterator::FULL_CACHE</constant> est défini.
   L'itérateur interne est ensuite avancé.
   Sinon, le <classname>CachingIterator</classname> n'est plus valide.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::rewind</methodname></member>
   <member><methodname>CachingIterator::hasNext</methodname></member>
   <member><methodname>CachingIterator::valid</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
