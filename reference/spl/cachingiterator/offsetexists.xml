<refentry xml:id="cachingiterator.offsetexists" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::offsetExists</refname>
  <refpurpose>Vérifie si un élément existe dans le cache</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>bool</type><methodname>CachingIterator::offsetExists</methodname>
   <methodparam><type>string</type><parameter>key</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Vérifie si un élément est stocké sous <parameter>key</parameter> dans
   le cache.
   Cette méthode est appelée lorsque <function>isset</function> ou <function>empty</function> est utilisé sur le
   <classname>CachingIterator</classname> avec la syntaxe de tableau, comme
   <code>isset($iterator['key'])</code>.
  </simpara>
  <simpara>
   Le drapeau <constant>CachingIterator::FULL_CACHE</constant> doit être défini.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      La clé à vérifier.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retourne &true; si un élément est stocké sous <parameter>key</parameter>
   dans le cache, &false; sinon.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lance une <exceptionname>BadMethodCallException</exceptionname> si le
   drapeau <constant>CachingIterator::FULL_CACHE</constant> n'est pas défini.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::offsetGet</methodname></member>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
