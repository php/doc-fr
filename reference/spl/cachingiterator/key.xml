<refentry xml:id="cachingiterator.key" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::key</refname>
  <refpurpose>Retourne la clé de l'élément courant</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>mixed</type><methodname>CachingIterator::key</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Retourne la clé de l'élément courant.
  </simpara>
  <simpara>
   Comme le <classname>CachingIterator</classname> garde une longueur d'avance
   d'un élément sur son itérateur interne, il s'agit de la clé qui a été
   stockée lors du dernier déplacement de l'itérateur, et non de la clé
   courante de l'itérateur interne.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retourne la clé de l'élément courant, ou &null; si l'itérateur n'est pas
   <link linkend="cachingiterator.valid">valide</link>.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::current</methodname></member>
   <member><methodname>CachingIterator::valid</methodname></member>
   <member><methodname>Iterator::key</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

