<refentry xml:id="cachingiterator.valid" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::valid</refname>
  <refpurpose>Vérifie si l'élément courant est valide</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>bool</type><methodname>CachingIterator::valid</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Vérifie si l'élément courant est valide.
  </simpara>
  <simpara>
   Un <classname>CachingIterator</classname> n'a pas d'élément courant tant que
   <methodname>CachingIterator::rewind</methodname> n'a pas été appelée, ce que
   &foreach; fait automatiquement.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retourne &true; si l'élément courant est valide, &false; sinon.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::hasNext</methodname></member>
   <member><methodname>CachingIterator::rewind</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
