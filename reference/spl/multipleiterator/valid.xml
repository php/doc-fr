<refentry xml:id="multipleiterator.valid" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::valid</refname>
  <refpurpose>Vérifie la validité d'un sous-itérateur</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>bool</type><methodname>MultipleIterator::valid</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Vérifie la validité des itérateurs attachés. Avec
   <constant>MultipleIterator::MIT_NEED_ALL</constant>, ils doivent tous être
   valides ; avec <constant>MultipleIterator::MIT_NEED_ANY</constant>, au moins
   l'un d'eux doit être valide.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retourne &true; si tous les itérateurs attachés sont valides
   (<constant>MultipleIterator::MIT_NEED_ALL</constant>) ou si au moins l'un
   d'eux est valide (<constant>MultipleIterator::MIT_NEED_ANY</constant>),
   &false; sinon. Si aucun itérateur n'est attaché, &false; est retourné.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>MultipleIterator::__construct</methodname></member>
   <member><methodname>MultipleIterator::setFlags</methodname></member>
   <member><methodname>MultipleIterator::current</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

